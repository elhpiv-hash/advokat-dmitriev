# ==========================================================================
#  .htaccess — Apache 2.4 (на 2.2 работают блоки с запасными директивами).
#  Каждый блок обёрнут в <IfModule>: если модуль на хостинге не подключён,
#  блок просто пропускается, а не роняет сайт ошибкой 500.
# ==========================================================================


# ----- Кодировка и MIME-типы ----------------------------------------------

AddDefaultCharset utf-8

<IfModule mod_mime.c>
  AddCharset utf-8 .css .js .json .xml .txt .svg
  # text/javascript — актуальный тип по RFC 9239
  AddType text/javascript      .js
  AddType font/woff2           .woff2
  AddType image/svg+xml        .svg
  AddType image/avif           .avif
  AddType image/webp           .webp
  AddType image/x-icon         .ico
  AddType application/xml      .xml
</IfModule>

# Не показывать список файлов в папках без index.html
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Своя страница «не найдено» — в стиле сайта. Путь от корня: 404.html
# подключает стили и скрипт по путям от корня, поэтому работает на любом адресе.
ErrorDocument 404 /404.html


# ----- Запрет отдачи служебных файлов -------------------------------------
# Исходные заметки, логи, бэкапы и скрипт сборки не должны открываться по URL.

<FilesMatch "(\.(md|log|bak|old|orig|swp|sh)|~)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Любые «скрытые» пути (.git/, .gitignore, .env …) — 404, чтобы не выдавать
# даже сам факт их существования. Исключение — .well-known (SSL, верификации).
# Туда же — служебные папки: tools/, исходник фото (assets/img/src/ —
# оригинал без обработки, возможно с EXIF) и скриншоты для согласования.
<IfModule mod_alias.c>
  RedirectMatch 404 "/\.(?!well-known/)"
  RedirectMatch 404 "/(tools|assets/img/src|screenshots)(/|$)"
</IfModule>


# ----- HTTPS и единый домен ------------------------------------------------
# Все адреса ведут на основной адрес — https, без www. Домен в правилах подставляет
# build.sh из SITE_URL. Сертификат Let's Encrypt должен быть выпущен ДО того, как
# эти правила окажутся на сервере (порядок — в README), иначе посетитель
# с http попадёт на https без сертификата и увидит предупреждение браузера.
#
# На REG.RU сайт может стоять за nginx: тогда Apache получает обычный http,
# а признак https приходит в заголовке X-Forwarded-Proto. Проверяем оба —
# иначе переадресация пошла бы по кругу. Если браузер всё же пишет «слишком
# много переадресаций», закомментируйте первые три строки RewriteCond/Rule
# и включите в панели хостинга «Перенаправлять HTTP-запросы в HTTPS».

<IfModule mod_rewrite.c>
  RewriteEngine On

  # http → https (сразу на адрес без www)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://advokat-dan.online%{REQUEST_URI} [R=301,L]

  # https://www → https:// без www
  RewriteCond %{HTTP_HOST} ^www\.advokat-dan\.online$ [NC]
  RewriteRule ^ https://advokat-dan.online%{REQUEST_URI} [R=301,L]
</IfModule>


# ----- Сжатие --------------------------------------------------------------
# Сжимаем только текстовые форматы. woff2 и jpeg уже сжаты — повторное сжатие
# только тратит процессор. Если есть brotli — он в приоритете, deflate
# остаётся для клиентов без поддержки brotli.

<IfModule mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType BROTLI_COMPRESS;DEFLATE text/html text/css text/javascript application/javascript application/json application/ld+json application/xml text/xml text/plain image/svg+xml image/x-icon
  </IfModule>
  <IfModule !mod_deflate.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/ld+json application/xml text/xml text/plain image/svg+xml image/x-icon
  </IfModule>
</IfModule>

<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/ld+json application/xml text/xml text/plain image/svg+xml image/x-icon
  </IfModule>
</IfModule>


# ----- Кэширование ---------------------------------------------------------
# CSS и JS подключаются с ?v=<хеш содержимого> и кэшируются на год как
# immutable: браузер даже не спрашивает сервер об изменениях. Хеш ставит
# build.sh — изменился файл, изменился и URL, кэш обходится сам.
# Шрифты кэшируются так же: при обновлении шрифта меняется имя файла.
# HTML — no-cache: браузер хранит копию, но каждый раз сверяется с сервером,
# так что правки страницы видны сразу, а ссылки на новые ?v= — подхватываются.

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                         "access plus 1 month"

  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType text/javascript          "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 month"
  ExpiresByType image/jpeg               "access plus 1 month"
  ExpiresByType image/avif               "access plus 1 month"
  ExpiresByType image/webp               "access plus 1 month"
  ExpiresByType image/x-icon             "access plus 1 week"
  ExpiresByType application/xml          "access plus 1 day"
  ExpiresByType text/xml                 "access plus 1 day"
  ExpiresByType text/plain               "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>


# ----- Заголовки безопасности ----------------------------------------------

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Только признанные браузерами директивы: на неизвестную (например, устаревшую
  # interest-cohort) Chrome пишет ошибку в консоль, а это минус в Lighthouse.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # CSP — только для HTML-страниц.
  # script-src: свои файлы + хеш единственного инлайн-скрипта в <head>
  #   (classList.add('js')). Хеш пересчитывает build.sh при каждой сборке.
  # style-src 'unsafe-inline' — ради атрибутов style="--v: …" у диаграмм:
  #   данные хранятся в разметке. Риск минимален: пользовательского контента на сайте нет.
  # img-src data: — фактура гранита (SVG-шум в CSS).
  # Яндекс.Метрика (грузится только после согласия на cookie): скрипт tag.js
  #   с mc.yandex.ru (+ yastatic.net), отправка данных — запросами и пикселем
  #   на mc.yandex.ru / mc.yandex.com. Список — по документации Метрики.
  # frame-src — виджет Яндекс Карт (*.yandex.ru покрывает и mc.yandex.ru).
  <FilesMatch "\.html?$">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' https://mc.yandex.ru https://yastatic.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com; font-src 'self'; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com; frame-src https://yandex.ru https://*.yandex.ru; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
  </FilesMatch>

  # HSTS — включить только когда HTTPS настроен окончательно: после этого браузеры
  # год будут отказываться открывать сайт по http.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
